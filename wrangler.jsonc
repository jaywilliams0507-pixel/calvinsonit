{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calvinsonit-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true},
  "triggers": {"crons": ["*/5 * * * *"]},
  "observability": {"enabled": false},
  "vars": {
    "APP_ORIGIN": "https://calvinsonit-staging.REPLACE.workers.dev",
    "ACCESS_TEAM_DOMAIN": "REPLACE.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE",
    "SUPABASE_URL": "https://REPLACE.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "REPLACE",
    "STRIPE_PRICE_AI_AUDIT": "REPLACE",
    "STRIPE_PRICE_CATALOG_STARTER": "REPLACE",
    "STRIPE_PRICE_CATALOG_FULL": "REPLACE",
    "STRIPE_PRICE_CATALOG_HOSTED": "REPLACE",
    "ALERT_EMAIL": "REPLACE",
    "EMAIL_FROM": "REPLACE",
    "STAGING_EMAIL_ALLOWLIST": "REPLACE"
  }
}
